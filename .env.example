# Application Configuration
APP_NAME=Livelihood-Assistant-AI
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Security & CORS
ALLOWED_ORIGINS=*

# AI & LLM Service Configuration (Placeholders - to be filled in later phases)
GEMINI_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Regional & Rules Data Paths
DATA_DIR=./data
SEED_DATA_DIR=./data/seed

# Phase 4 — deterministic skill normalization
# Inputs below the confidence threshold remain UNKNOWN.
SKILL_NORMALIZATION_MIN_CONFIDENCE=0.90
SKILL_NORMALIZATION_PHRASE_CONFIDENCE=0.95
